# ==============================================================================
# AetherOS — Aether Agent Suite Environment Configuration
# ==============================================================================

# ================= REQUIRED =================
# Anthropic API Key (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="You can put your API key here"

# ============== AGENT ACCESS CONTROL ==============
# Leave both empty to unlock the full unified Aether Agent Suite (all agents + Nexus).
# To lock the studio to a single agent, set the agent slug (e.g., OWNED_AGENT=createur-contenu).
OWNED_AGENT=
NEXT_PUBLIC_OWNED_AGENT=

# Optional redirect URL shown when an agent is locked
NEXT_PUBLIC_UNLOCK_URL=

# ================= OPTIONAL INTEGRATIONS =================
# Apify Token — Web scraping & audience intelligence (Pulse / Hunter)
APIFY_TOKEN="You can put your API key here"

# Fireflies API Key — Meeting intelligence and voice call transcripts (Echo)
FIREFLIES_API_KEY="You can put your API key here"

# Google Gemini API Key — AI image generation & vision capabilities (Muse)
GEMINI_API_KEY="You can put your API key here"

# Airtable Token — CRM and structured database synchronization
AIRTABLE_TOKEN="You can put your API key here"

# Google OAuth Credentials — Gmail outreach & Google Drive synchronization
GOOGLE_CLIENT_ID="You can put your API key here"
GOOGLE_CLIENT_SECRET="You can put your API key here"
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Anthropic Claude Model Overrides (optional, defaults to Sonnet 4 / Opus 4)
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
ANTHROPIC_MODEL_OPUS=claude-opus-4-20250514
